APP_ENV=development
DATABASE_PATH=./data/app.sqlite
UPLOAD_DIR=./data/uploads
CORS_ORIGINS=http://localhost:3000

# Clerk instance Frontend API origin, shown as the `iss` claim in a session token.
CLERK_ISSUER=https://replace-with-your-instance.clerk.accounts.dev
# Optional but recommended for networkless JWT verification. Paste the Clerk
# Dashboard JWT public key; literal \n sequences are accepted.
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# Bootstrap override. Public metadata role=admin remains the normal role source.
CLERK_ADMIN_USER_IDS=

# Production only: authorizes read-only snapshots requested by staging.
STAGING_PULL_TOKEN=generate-a-separate-long-random-token

# Staging only: fixed production source and the matching snapshot token.
PRODUCTION_API_URL=https://api.planning.hfgok.com/api
PRODUCTION_SYNC_TOKEN=generate-a-separate-long-random-token
