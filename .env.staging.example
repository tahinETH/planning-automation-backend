APP_ENV=staging
DATABASE_PATH=./data/staging.sqlite
UPLOAD_DIR=./data/uploads-staging
CORS_ORIGINS=http://localhost:3001
CLERK_ISSUER=https://replace-with-staging-instance.clerk.accounts.dev
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:3001
CLERK_ADMIN_USER_IDS=
PRODUCTION_API_URL=https://api.planning.hfgok.com/api
PRODUCTION_SYNC_TOKEN=replace-with-the-production-staging-pull-token

# Ravi (backend only)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# CPM read-only collector integration (disabled by default)
CPM_ENABLED=false
CPM_ALLOW_PRODUCTION=false
CPM_COLLECTOR_TOKEN=
CPM_REFRESH_INTERVAL_SECONDS=900
# Optional Telegram error/recovery alerting (disabled until configured)
CPM_ALERT_TELEGRAM_BOT_TOKEN=
CPM_ALERT_TELEGRAM_CHAT_ID=
CPM_ALERT_COOLDOWN_SECONDS=1800
